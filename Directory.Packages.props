<!--
  Central Package Management — single source of truth for all NuGet versions.
  See: https://learn.microsoft.com/nuget/consume-packages/central-package-management

  To update a package: change the Version here; all projects pick it up automatically.
  Projects must NOT specify Version on <PackageReference> — only metadata such as
  PrivateAssets / IncludeAssets / Condition may remain there.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The versions below also apply to transitive dependencies, so a vulnerable one can be overridden here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- ── UI Framework ──────────────────────────────────────────────────── -->
  <ItemGroup Label="WinUI">
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Reads WinUI crashes that bypass .NET from the Application event log (NativeCrashDetector). -->
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <!-- Installer and background updates from GitHub Releases. -->
    <PackageVersion Include="Velopack" Version="1.2.158" />
  </ItemGroup>
  <ItemGroup Label="MAUI">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <!-- Fingerprint or face sign-in (Android). Its AndroidX dependencies match the ones MAUI already uses. -->
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.30" />
  </ItemGroup>
  <!-- ── Crash reports (Sentry SDK, sent to GlitchTip) ────────────────── -->
  <ItemGroup Label="Crash reports">
    <PackageVersion Include="Sentry" Version="6.11.1" />
    <PackageVersion Include="Sentry.Maui" Version="6.11.1" />
    <PackageVersion Include="Sentry.Serilog" Version="6.11.1" />
  </ItemGroup>
  <!-- ── MVVM ────────────────────────────────────────────────────────── -->
  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <!-- ── Microsoft Extensions ─────────────────────────────────────────── -->
  <ItemGroup Label="Microsoft Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>
  <!-- ── Logging ───────────────────────────────────────────────────────── -->
  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <!-- ── Security ──────────────────────────────────────────────────────── -->
  <ItemGroup Label="Security">
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <!-- ── Testing ───────────────────────────────────────────────────────── -->
  <ItemGroup Label="Testing">
    <!-- Code coverage for dotnet test (Microsoft.Testing.Platform extension). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Runs on Microsoft.Testing.Platform v2 (see global.json); no VSTest packages needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <!-- ── Analyzers (every project) ─────────────────────────────────────── -->
  <ItemGroup Label="Analyzers">
    <!-- Only the async void / unobserved task rules are on; see .editorconfig. -->
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>
</Project>