<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RecuperationSystem.WinUI.Views.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RecuperationSystem.WinUI.Helpers"
    xmlns:loc="using:RecuperationSystem.Core.Localization"
    xmlns:controls="using:RecuperationSystem.WinUI.Controls">

    <Grid>
        <Grid MaxWidth="1100" Padding="24,8,24,24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Header ───────────────────────────────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind loc:Strings.ScheduleTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="{x:Bind loc:Strings.ScheduleHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.EntryCountText, Mode=OneWay}" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Command="{x:Bind ViewModel.LoadCommand}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.ScheduleReload}" AutomationProperties.Name="{x:Bind loc:Strings.ScheduleReload}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Notices ──────────────────────────────────────────────── -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar Severity="Informational" IsClosable="False" Title="{x:Bind loc:Strings.ScheduleModeOffTitle}"
                         Message="{x:Bind loc:Strings.ScheduleModeOffMessage}"
                         IsOpen="{x:Bind helpers:Xaml.IsNotScheduleMode(Main.OperatingMode.SelectedMode), Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind loc:Strings.ScheduleUseScheduleMode}" Click="OnUseScheduleModeClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar Severity="Warning" IsClosable="False"
                         IsOpen="{x:Bind helpers:Xaml.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>

            <!-- ── Legend (filled from the unit's modes) ────────────────── -->
            <StackPanel x:Name="Legend" Grid.Row="2" Orientation="Horizontal" Spacing="16" />

            <!-- ── Grid ─────────────────────────────────────────────────── -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8,12,8,0">
                <controls:WeekScheduleGrid x:Name="WeekGrid" />
            </Border>
        </Grid>

        <Button Style="{StaticResource FloatingActionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,40"
                IsEnabled="{x:Bind ViewModel.CanAddEntry, Mode=OneWay}" Click="OnAddClick"
                ToolTipService.ToolTip="{x:Bind loc:Strings.ScheduleAddAction}" AutomationProperties.Name="{x:Bind loc:Strings.ScheduleAddAction}">
            <FontIcon Glyph="&#xE710;" FontSize="20" />
        </Button>
    </Grid>
</UserControl>
