<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RecuperationSystem.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RecuperationSystem.WinUI.Helpers"
    xmlns:loc="using:RecuperationSystem.Core.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" Padding="24,8,24,24" Spacing="16">
            <TextBlock Text="{x:Bind loc:Strings.SettingsTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- ── Language (Win11 Settings-style card) ─────────────────── -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xF2B7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsLanguage}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind loc:Strings.SettingsLanguageDescription}" Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind loc:Strings.SettingsLanguage}"
                              ItemsSource="{x:Bind ViewModel.Languages}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loc:AppLanguage">
                                <TextBlock Text="{x:Bind NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ── Appearance ───────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsTheme}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind loc:Strings.SettingsThemeDescription}" Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <!-- In AppTheme order: System, Light, Dark. -->
                        <StackPanel x:Name="ThemeChoices" Margin="0,4,0,0">
                            <RadioButton GroupName="Theme" Content="{x:Bind loc:Strings.SettingsThemeSystem}" Checked="OnThemeChecked"
                                         IsChecked="{x:Bind helpers:Xaml.IsIndex(ViewModel.ThemeIndex, 0), Mode=OneWay}" />
                            <RadioButton GroupName="Theme" Content="{x:Bind loc:Strings.SettingsThemeLight}" Checked="OnThemeChecked"
                                         IsChecked="{x:Bind helpers:Xaml.IsIndex(ViewModel.ThemeIndex, 1), Mode=OneWay}" />
                            <RadioButton GroupName="Theme" Content="{x:Bind loc:Strings.SettingsThemeDark}" Checked="OnThemeChecked"
                                         IsChecked="{x:Bind helpers:Xaml.IsIndex(ViewModel.ThemeIndex, 2), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Startup ──────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsRunAtStartup}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind loc:Strings.SettingsRunAtStartupDescription}" Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind loc:Strings.SettingsRunAtStartup}"
                                  IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <FontIcon Grid.Row="2" Glyph="&#xE921;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsStartInTray}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind loc:Strings.SettingsStartInTrayDescription}" Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Row="2" Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind loc:Strings.SettingsStartInTray}"
                                  IsOn="{x:Bind ViewModel.StartInTray, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ── Closing the window ────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8BB;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsCloseTitle}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind loc:Strings.SettingsCloseDescription}" Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <!-- The second option follows the first: checking it unchecks "Minimize to tray", which saves false. -->
                        <StackPanel Margin="0,4,0,0">
                            <RadioButton GroupName="CloseBehavior" Content="{x:Bind loc:Strings.SettingsMinimizeToTray}"
                                         IsChecked="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                            <RadioButton GroupName="CloseBehavior" Content="{x:Bind loc:Strings.SettingsExitApp}"
                                         IsChecked="{x:Bind helpers:Xaml.Not(ViewModel.MinimizeToTray), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Unit: name, model, serial number, service contact (after sign-in) ── -->
            <Border Style="{StaticResource CardStyle}" Padding="16"
                    Visibility="{x:Bind helpers:Xaml.VisibleIfNotNull(Main.Unit), Mode=OneWay}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <FontIcon Glyph="&#xE8AC;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.UnitNameLabel}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind Main.PortalUnitName, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Content="{x:Bind loc:Strings.UnitRename}" Click="OnRenameUnitClick" />

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <FontIcon Grid.Row="2" Glyph="&#xE772;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsUnit}" Style="{StaticResource BodyTextBlockStyle}" />
                        <!-- Selectable: the service company asks for the model and serial number. -->
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   Text="{x:Bind helpers:Xaml.UnitDetails(Main.Unit), Mode=OneWay}" />
                    </StackPanel>

                    <Border Grid.Row="3" Grid.ColumnSpan="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <FontIcon Grid.Row="4" Glyph="&#xE779;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsService}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True"
                                   Text="{x:Bind helpers:Xaml.ServiceName(Main.Unit), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <HyperlinkButton Content="{x:Bind helpers:Xaml.ServiceMail(Main.Unit), Mode=OneWay}"
                                         NavigateUri="{x:Bind helpers:Xaml.ServiceMailUri(Main.Unit), Mode=OneWay}"
                                         Visibility="{x:Bind helpers:Xaml.VisibleIfServiceMail(Main.Unit), Mode=OneWay}" />
                        <HyperlinkButton Content="{x:Bind helpers:Xaml.ServiceWebText(Main.Unit), Mode=OneWay}"
                                         NavigateUri="{x:Bind helpers:Xaml.ServiceWebUri(Main.Unit), Mode=OneWay}"
                                         Visibility="{x:Bind helpers:Xaml.VisibleIfServiceWeb(Main.Unit), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── About ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Source="ms-appx:///Assets/app-icon.ico" Width="20" Height="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Strings.SettingsAbout}" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True"
                                   Text="{x:Bind helpers:Xaml.AboutText(ViewModel.Version)}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Content="{x:Bind loc:Strings.SettingsProjectLink}"
                                     NavigateUri="https://github.com/viliamb992/wafe-recuperation-app" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
