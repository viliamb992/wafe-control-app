<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Localization\Strings.resx is Czech, the primary language; Slovak and English are satellite assemblies. -->
    <NeutralLanguage>cs</NeutralLanguage>
    <!-- Generate the Strings class in design-time builds too, so the IDE sees it before the first build. -->
    <CoreCompileDependsOn>PrepareResources;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Typed accessors (Strings.LoginTitle, ...) generated into obj/ at build time. -->
    <EmbeddedResource Update="Localization\Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="WafeControl.Core.Localization"
                      StronglyTypedClassName="Strings"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WafeControl.Shared\WafeControl.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WafeControl.Tests" />
  </ItemGroup>

</Project>
