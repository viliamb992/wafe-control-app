<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WafeControl.Mobile.Views.ScheduleDayCopyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WafeControl.Mobile.Controls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:loc="clr-namespace:WafeControl.Core.Localization;assembly=WafeControl.Core"
    xmlns:schedule="clr-namespace:WafeControl.Core.ViewModels.Schedule;assembly=WafeControl.Core"
    x:DataType="schedule:ScheduleDayCopyViewModel"
    ios:Page.ModalPresentationStyle="PageSheet">

    <Grid RowDefinitions="Auto,*">
        <!-- ── Sheet header: Cancel · title · Copy ───────────────────── -->
        <Grid ColumnDefinitions="*,Auto,*" Padding="4,8">
            <Button Style="{StaticResource SubtleButton}" Text="{x:Static loc:Strings.ButtonCancel}" HorizontalOptions="Start" Clicked="OnCancelClicked" />
            <Label Grid.Column="1" Text="{x:Static loc:Strings.ScheduleCopyDay}" Style="{StaticResource BodyStrong}" FontSize="18" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Grid Grid.Column="2" HorizontalOptions="End">
                <Button x:Name="CopyButton" Style="{StaticResource AccentTextButton}" Text="{x:Static loc:Strings.ButtonCopy}" Clicked="OnCopyClicked" />
                <ActivityIndicator x:Name="Busy" Style="{StaticResource SmallSpinner}" IsVisible="False" HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="12" MaximumWidthRequest="560">
                <!-- The day being copied -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding FromDayName}" Style="{StaticResource BodyStrong}" VerticalOptions="Center" />
                        <Label x:Name="ActionCount" Grid.Column="1" Style="{StaticResource SecondaryBody}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Target days: tap to check -->
                <Label Text="{x:Static loc:Strings.ScheduleCopyTo}" Style="{StaticResource SecondaryCaption}" Margin="4,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout x:Name="DayList" />
                </Border>
                <Label Text="{x:Static loc:Strings.ScheduleCopyReplaces}" Style="{StaticResource SecondaryCaption}" Margin="4,0" />

                <controls:InfoBanner Severity="Error" Message="{Binding ErrorMessage}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
