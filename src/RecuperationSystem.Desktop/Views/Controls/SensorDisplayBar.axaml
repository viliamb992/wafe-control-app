<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels"
             x:Class="RecuperationSystem.Desktop.Views.Controls.SensorDisplayBar"
             x:DataType="vm:AppViewModel">
    
    <Border Background="{StaticResource BackgroundDarkBrush}"
            Padding="20,15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Outside Temp -->
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- Thermometer icon -->
                            <Path Data="M15,13V5A3,3 0 0,0 9,5V13A5,5 0 1,0 15,13M12,4A1,1 0 0,1 13,5V8H11V5A1,1 0 0,1 12,4Z" 
                                  Fill="White" Opacity="0.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Outside" 
                              FontSize="10" 
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource PrimaryLightBrush}"
                          HorizontalAlignment="Center">
                    <Run Text="{Binding OutsideTemp, StringFormat='{}{0:F1}'}"/><Run Text="&#176;C"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Fresh Temp -->
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- Wind/Air icon -->
                            <Path Data="M3.5,9A1.5,1.5 0 0,1 5,7.5A1.5,1.5 0 0,1 6.5,9H11.5A1.5,1.5 0 0,1 13,10.5A1.5,1.5 0 0,1 11.5,12H3.5A1.5,1.5 0 0,1 2,10.5A1.5,1.5 0 0,1 3.5,9M6.5,13H20.5A2.5,2.5 0 0,1 23,15.5A2.5,2.5 0 0,1 20.5,18H6.5A2.5,2.5 0 0,1 4,15.5A2.5,2.5 0 0,1 6.5,13Z" 
                                  Fill="White" Opacity="0.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Fresh Air" 
                              FontSize="10" 
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource SuccessLightBrush}"
                          HorizontalAlignment="Center">
                    <Run Text="{Binding FreshTemp, StringFormat='{}{0:F1}'}"/><Run Text="&#176;C"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Indoor Temp -->
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- Home icon -->
                            <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" 
                                  Fill="White" Opacity="0.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Indoor" 
                              FontSize="10" 
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource WarningBrush}"
                          HorizontalAlignment="Center">
                    <Run Text="{Binding IndoorTemp, StringFormat='{}{0:F1}'}"/><Run Text="&#176;C"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Waste Temp -->
            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- Export/Output arrow icon -->
                            <Path Data="M12,2L4,5V11.09C4,16.14 7.41,20.85 12,22C16.59,20.85 20,16.14 20,11.09V5L12,2M12,12.5L16,8.5L14.59,7.09L12,9.67L9.41,7.09L8,8.5L12,12.5Z" 
                                  Fill="White" Opacity="0.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Waste Air" 
                              FontSize="10" 
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource DangerBrush}"
                          HorizontalAlignment="Center">
                    <Run Text="{Binding WasteTemp, StringFormat='{}{0:F1}'}"/><Run Text="&#176;C"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Current Flow -->
            <Border Grid.Column="4"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <!-- Fan/Flow icon -->
                                <Path Data="M12,11A1,1 0 0,0 11,12A1,1 0 0,0 12,13A1,1 0 0,0 13,12A1,1 0 0,0 12,11M4.22,4.22C2.65,5.79 1.68,7.88 1.46,10.11C1.44,10.32 1.43,10.54 1.43,10.75C1.43,11.14 1.46,11.53 1.5,11.91C1.65,13.15 2.08,14.32 2.73,15.35C3.39,16.38 4.26,17.24 5.29,17.89C6.32,18.55 7.5,18.97 8.74,19.12C9.12,19.16 9.5,19.18 9.89,19.18C10.1,19.18 10.31,19.17 10.53,19.15C12.76,18.93 14.85,17.96 16.42,16.39L12,12M19.5,11.91C19.46,11.53 19.43,11.14 19.43,10.75C19.43,10.54 19.44,10.32 19.46,10.11C19.68,7.88 18.71,5.79 17.14,4.22L12.71,8.65M8.65,12.71L4.22,17.14C5.79,18.71 7.88,19.68 10.11,19.9C10.32,19.92 10.54,19.93 10.75,19.93C11.14,19.93 11.53,19.9 11.91,19.86C14.15,19.64 16.24,18.67 17.81,17.1M19.78,4.22L17.14,6.86C18.71,8.43 19.68,10.52 19.9,12.75C19.92,12.96 19.93,13.18 19.93,13.39C19.93,13.78 19.9,14.17 19.86,14.55C19.64,16.79 18.67,18.88 17.1,20.45L12.71,16.06L16.06,12.71" 
                                      Fill="White" Opacity="0.9"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock FontSize="10" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center">
                            <Run Text="Current Flow"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryLightBrush}"
                              HorizontalAlignment="Center">
                        <Run Text="{Binding CurrentFlow, StringFormat='{}{0} m'}"/><Run Text="3" BaselineAlignment="Superscript" FontSize="11"/><Run Text="/h"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- CO2 Level -->
            <Border Grid.Column="5"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <!-- Cloud/Gas icon -->
                                <Path Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04Z" 
                                      Fill="White" Opacity="0.9"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock FontSize="10" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center">
                            <Run Text="CO"/><Run Text="2" BaselineAlignment="Subscript" FontSize="7"/><Run Text=" Level"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Co2Level, StringFormat='{}{0} ppm'}" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="{StaticResource InfoBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
