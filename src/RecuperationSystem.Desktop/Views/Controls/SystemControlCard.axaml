<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             xmlns:mainVm="using:RecuperationSystem.Desktop.ViewModels"
             x:Class="RecuperationSystem.Desktop.Views.Controls.SystemControlCard"
             x:DataType="vm:SystemControlCardViewModel">
    
    <Border Background="{StaticResource BackgroundDarkBrush}"
            CornerRadius="12"
            Padding="20"
            BorderThickness="1"
            BorderBrush="{StaticResource BackgroundLightBrush}">
        <StackPanel Spacing="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                          Text="System Control" 
                          FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Grid.Column="1"
                       Background="{StaticResource BackgroundMediumBrush}"
                       CornerRadius="6"
                       Padding="10,5">
                    <TextBlock Text="{Binding CurrentAuthority, StringFormat='Mode: {0}'}" 
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource PrimaryLightBrush}"/>
                </Border>
            </Grid>
            
            <!-- Single Toggle Button -->
            <Button Command="{Binding ToggleSystemCommand}" 
                   Height="60"
                   BorderThickness="0"
                   CornerRadius="12"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Center"
                   Background="{Binding IsSystemRunning, Converter={x:Static mainVm:BoolToBrushConverter.Instance}, ConverterParameter='SystemRunningGradient|SystemStoppedGradient'}">
                <Grid>
                    <!-- Normal State -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                               IsVisible="{Binding !IsOperationInProgress}">
                        <Border Background="{StaticResource OverlayLightBrush}"
                               CornerRadius="24"
                               Width="40" Height="40"
                               VerticalAlignment="Center">
                            <Grid>
                                <!-- Start Icon (Play) -->
                                <Viewbox Width="20" Height="20" IsVisible="{Binding !IsSystemRunning}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M8,5 L8,19 L19,12 Z" 
                                              Fill="White"/>
                                    </Canvas>
                                </Viewbox>
                                <!-- Stop Icon (Square) -->
                                <Viewbox Width="20" Height="20" IsVisible="{Binding IsSystemRunning}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,6 L18,6 L18,18 L6,18 Z" 
                                              Fill="White"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SystemToggleButtonText}" 
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Loading State -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                               IsVisible="{Binding IsOperationInProgress}">
                        <Border Background="{StaticResource OverlayLightBrush}"
                               CornerRadius="24"
                               Width="40" Height="40"
                               VerticalAlignment="Center">
                            <Grid Width="20" Height="20">
                                <Ellipse Stroke="White"
                                        StrokeThickness="2"
                                        Opacity="0.3"
                                        Width="20"
                                        Height="20"/>
                                <Ellipse Stroke="White"
                                        StrokeThickness="2"
                                        StrokeDashArray="12,8"
                                        Width="20"
                                        Height="20">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <TextBlock Text="Processing..." 
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
