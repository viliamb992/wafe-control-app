<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             xmlns:mainVm="using:RecuperationSystem.Desktop.ViewModels"
             x:Class="RecuperationSystem.Desktop.Views.Controls.SystemControlCard"
             x:DataType="vm:SystemControlCardViewModel">

	<Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="{StaticResource CardPadding}"
            BorderThickness="{StaticResource CardBorderThickness}"
            BorderBrush="{DynamicResource CardBorderBrush}">
		<StackPanel Spacing="10">
			<Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="4">
				<TextBlock Grid.Row="0" Grid.Column="0"
                           Text="System"
                           FontSize="16"
                           FontWeight="SemiBold"/>

				<TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Start or stop ventilation"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>

			</Grid>

			<Button Command="{Binding ToggleSystemCommand}"
					Height="40"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center"
					IsEnabled="{Binding !IsOperationInProgress}">
				<Grid>
					<StackPanel Orientation="Horizontal" Spacing="8"
							   IsVisible="{Binding !IsOperationInProgress}">
						<Viewbox Width="14" Height="14" VerticalAlignment="Center">
							<Canvas Width="24" Height="24">
								<!-- Start icon -->
								<Path Data="M8,5 L8,19 L19,12 Z"
									  Fill="{DynamicResource SystemBaseHighColor}"
									  IsVisible="{Binding !IsSystemRunning}"/>
								<!-- Stop icon -->
								<Path Data="M6,6 L18,6 L18,18 L6,18 Z"
									  Fill="{DynamicResource SystemBaseHighColor}"
									  IsVisible="{Binding IsSystemRunning}"/>
							</Canvas>
						</Viewbox>
						<TextBlock Text="{Binding SystemToggleButtonText}" VerticalAlignment="Center"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8"
							   IsVisible="{Binding IsOperationInProgress}">
						<Grid Width="18" Height="18" VerticalAlignment="Center">
							<Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="2" Width="18" Height="18"/>
							<Ellipse Stroke="{DynamicResource SystemAccentColor}" StrokeThickness="2" StrokeDashArray="10,6" Width="18" Height="18">
								<Ellipse.RenderTransform>
									<RotateTransform/>
								</Ellipse.RenderTransform>
								<Ellipse.Styles>
									<Style Selector="Ellipse">
										<Style.Animations>
											<Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
												<KeyFrame Cue="0%">
													<Setter Property="(RotateTransform.Angle)" Value="0"/>
												</KeyFrame>
												<KeyFrame Cue="100%">
													<Setter Property="(RotateTransform.Angle)" Value="360"/>
												</KeyFrame>
											</Animation>
										</Style.Animations>
									</Style>
								</Ellipse.Styles>
							</Ellipse>
						</Grid>
						<TextBlock Text="Processing..." VerticalAlignment="Center"/>
					</StackPanel>
				</Grid>
			</Button>
		</StackPanel>
	</Border>
</UserControl>
