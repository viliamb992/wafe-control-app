<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             x:Class="RecuperationSystem.Desktop.Views.Controls.FlowSpeedCard"
             x:DataType="vm:FlowSpeedCardViewModel">
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="{StaticResource CardPadding}"
            BorderThickness="{StaticResource CardBorderThickness}"
            BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Flow speed"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Adjust airflow in manual mode"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsChanging}">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="2" Width="18" Height="18"/>
                        <Ellipse Stroke="{DynamicResource SystemAccentColor}" StrokeThickness="2" StrokeDashArray="10,6" Width="18" Height="18">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    ClipToBounds="True">
                <StackPanel>
                    <Border Padding="{StaticResource CardRowPadding}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Speed" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="{StaticResource CornerRadiusSmall}"
                                    Padding="10,6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardBorderBrush}">
                                <TextBlock x:Name="FlowSpeedDisplay"
                                           FontSize="14"
                                           FontWeight="SemiBold">
                                    <Run x:Name="FlowSpeedValue" Text="0"/><Run Text=" m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="10"/><Run Text="/h"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{StaticResource CardDividerBrush}"/>
            
            <Slider x:Name="FlowSpeedSlider"
                   Minimum="50" 
                   Maximum="220" 
                   TickFrequency="10"
                   IsSnapToTickEnabled="True"
                   Height="40"
                   IsEnabled="{Binding !IsChanging}"
                   ValueChanged="OnFlowSpeedValueChanged"
                   PointerPressed="OnSliderPointerPressed"
                   PointerReleased="OnSliderPointerReleased"/>
            
                    <Border Padding="{StaticResource CardRowPaddingCompact}">
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" 
                                      Text="Min 50" 
                                      FontSize="12"
                                      Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBlock Grid.Column="1" 
                                      Text="Max 220" 
                                      FontSize="12"
                                      Foreground="{DynamicResource SystemBaseMediumColor}"
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
