<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             x:Class="RecuperationSystem.Desktop.Views.Controls.FlowSpeedCard"
             x:DataType="vm:FlowSpeedCardViewModel">
    
    <Border Background="{StaticResource BackgroundDarkBrush}"
            CornerRadius="12"
            Padding="20"
            BorderThickness="1"
            BorderBrush="{StaticResource BackgroundLightBrush}">
        <StackPanel Spacing="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                          Text="Flow Speed" 
                          FontSize="16" 
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <!-- Loading Spinner -->
                <Border Grid.Column="1"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsChanging}">
                    <Grid Width="20" Height="20">
                        <Ellipse Stroke="{StaticResource BackgroundLightBrush}"
                                StrokeThickness="2"
                                Width="20"
                                Height="20"/>
                        <Ellipse Stroke="{StaticResource PrimaryLightBrush}"
                                StrokeThickness="2"
                                StrokeDashArray="12,8"
                                Width="20"
                                Height="20">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                </Border>
                
                <Border Grid.Column="2"
                        Background="{StaticResource BackgroundMediumBrush}"
                        CornerRadius="6"
                        Padding="10,5">
                    <TextBlock x:Name="FlowSpeedDisplay"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryLightBrush}">
                        <Run x:Name="FlowSpeedValue" Text="0"/><Run Text=" m"/><Run Text="3" BaselineAlignment="Superscript" FontSize="11"/><Run Text="/h"/>
                    </TextBlock>
                </Border>
            </Grid>
            
            <Slider x:Name="FlowSpeedSlider"
                   Minimum="50" 
                   Maximum="220" 
                   TickFrequency="10"
                   IsSnapToTickEnabled="True"
                   Height="40"
                   IsEnabled="{Binding !IsChanging}"
                   ValueChanged="OnFlowSpeedValueChanged"
                   PointerPressed="OnSliderPointerPressed"
                   PointerReleased="OnSliderPointerReleased"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                          Text="Min (50)" 
                          FontSize="11"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" 
                          Text="Max (220)" 
                          FontSize="11"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
