<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             x:Class="RecuperationSystem.Desktop.Views.Controls.OperatingModeCard"
             x:DataType="vm:OperatingModeCardViewModel">
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="{StaticResource CardPadding}"
            BorderThickness="{StaticResource CardBorderThickness}"
            BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Operating mode"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Choose how the system is controlled"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsModeChanging}">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="2" Width="18" Height="18"/>
                        <Ellipse Stroke="{DynamicResource SystemAccentColor}" StrokeThickness="2" StrokeDashArray="10,6" Width="18" Height="18">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="Infinite" Easing="LinearEasing">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    ClipToBounds="True">
                <Border Padding="{StaticResource CardRowPadding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Mode" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1"
                                 x:Name="ModeComboBox"
                                 x:FieldModifier="public"
                                 MinWidth="220"
                                 Height="36"
                                 FontSize="14"
                                 SelectionChanged="OnModeChanged"
                                 IsEnabled="{Binding !IsModeChanging}">
                <ComboBoxItem Tag="intelligent" x:Name="IntelligentModeItem" x:FieldModifier="public">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z" 
                                      Fill="{DynamicResource SystemBaseHighColor}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Intelligent (Auto)" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="manual" x:Name="ManualModeItem" x:FieldModifier="public">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" 
                                      Fill="{DynamicResource SystemBaseHighColor}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Manual Control" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="schedule" x:Name="ScheduleModeItem" x:FieldModifier="public">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" 
                                      Fill="{DynamicResource SystemBaseHighColor}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Schedule Based" VerticalAlignment="Center"/>
                    </StackPanel>
                </ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>
            </Border>

            <TextBlock Text="Intelligent: System adjusts automatically based on sensors"
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsIntelligentMode}"/>
            <TextBlock Text="Manual: You control the flow speed directly"
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsManualMode}"/>
            <TextBlock Text="Schedule: System follows your weekly schedule"
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsScheduleMode}"/>
        </StackPanel>
    </Border>
</UserControl>
