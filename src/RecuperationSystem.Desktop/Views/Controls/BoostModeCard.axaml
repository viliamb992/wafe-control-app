<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels.Cards"
             x:Class="RecuperationSystem.Desktop.Views.Controls.BoostModeCard"
             x:DataType="vm:BoostModeCardViewModel">
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="{StaticResource CardPadding}"
            BorderThickness="{StaticResource CardBorderThickness}"
            BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel Spacing="10">
			<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Boost"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Quickly increase ventilation for a short period"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextWrapping="Wrap"/>
            </Grid>
            
			<Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="0"
			      HorizontalAlignment="Center">
				<Button Grid.Column="0" Classes="Segment Left" Command="{Binding SetBoostCommand}" CommandParameter="900">
                    <TextBlock Text="15 min"/>
                </Button>
                <Button Grid.Column="1" Classes="Segment Middle" Command="{Binding SetBoostCommand}" CommandParameter="1800">
                    <TextBlock Text="30 min"/>
                </Button>
                <Button Grid.Column="2" Classes="Segment Right" Command="{Binding SetBoostCommand}" CommandParameter="3600">
                    <TextBlock Text="60 min"/>
                </Button>
            </Grid>
            
			<Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Center"
			      IsVisible="{Binding IsBoostActive}">
				<Button Grid.Column="0"
						Command="{Binding SetBoostCommand}"
						CommandParameter="0"
						Height="36">
					<TextBlock Text="Stop boost"/>
				</Button>

				<Border Grid.Column="1"
						VerticalAlignment="Center"
						Background="{DynamicResource WindowBackgroundBrush}"
						BorderBrush="{DynamicResource CardBorderBrush}"
						BorderThickness="1"
						CornerRadius="{StaticResource CornerRadiusSmall}"
						Padding="10,6"
						MinWidth="130">
					<TextBlock FontSize="12"
							   Foreground="{DynamicResource SystemBaseMediumColor}"
							   VerticalAlignment="Center"
							   TextWrapping="NoWrap">
						<Run Text="Remaining: "/>
						<Run Text="{Binding BoostRemainingText}"
							 FontWeight="SemiBold"
							 Foreground="{DynamicResource SystemAccentColor}"/>
					</TextBlock>
				</Border>
			</Grid>
        </StackPanel>
    </Border>
</UserControl>
