<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RecuperationSystem.Desktop.ViewModels"
             x:Class="RecuperationSystem.Desktop.Views.Controls.ConnectingScreen"
             x:DataType="vm:AppViewModel">
    
    <Border Background="{StaticResource BackgroundMediumBrush}">
        <StackPanel VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Spacing="20">
            <Border Width="80" Height="80"
                    CornerRadius="40"
                    HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{StaticResource Primary}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Animated Progress Ring -->
                <Grid Width="40" Height="40">
                    <Ellipse Stroke="White"
                            StrokeThickness="3"
                            Opacity="0.3"
                            Width="40"
                            Height="40"/>
                    <Ellipse Stroke="White"
                            StrokeThickness="3"
                            StrokeDashArray="25,15"
                            Width="40"
                            Height="40">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="LinearEasing">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                </Grid>
            </Border>
            <TextBlock Text="Connecting to Wafe System..." 
                      FontSize="20" 
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding StatusMessage}" 
                      FontSize="14" 
                      Foreground="{StaticResource TextSecondaryBrush}"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="400"
                      TextAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
