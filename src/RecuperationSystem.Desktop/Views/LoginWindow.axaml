<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecuperationSystem.Desktop.ViewModels"
        x:Class="RecuperationSystem.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sign in"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        CanResize="False">

  <Border Padding="20" ClipToBounds="True">
    <Grid>
      <!-- subtle accent tint like MainWindow -->
      <Border Background="{DynamicResource WindowAccentTintBrush}"
              Opacity="0.6"
              IsHitTestVisible="False"/>

      <Border Background="{DynamicResource CardBackgroundBrush}"
              CornerRadius="{StaticResource CornerRadiusLarge}"
              BorderThickness="{StaticResource CardBorderThickness}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              Padding="{StaticResource CardPadding}">
        <StackPanel Spacing="12">

          <StackPanel Spacing="4">
            <TextBlock Text="Sign in" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Connect to Wafe API"
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Username" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            <TextBox Text="{Binding Username}" Watermark="Username" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Password" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Password" />
          </StackPanel>

          <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}" />

          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage}"
                     Foreground="#E81123"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Sign in" Command="{Binding SubmitCommand}" IsDefault="True" />
          </StackPanel>

        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
