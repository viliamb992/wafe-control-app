<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RecuperationSystem.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Fluent.axaml"/>
                <ResourceInclude Source="/Styles/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
        
        <!-- Global Styles -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style Selector="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, Arial, sans-serif"/>
        </Style>

        <!-- Segmented buttons (Fluent-like) -->
        <Style Selector="Button.Segment">
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.Segment.Left">
            <Setter Property="CornerRadius" Value="10,0,0,10"/>
        </Style>

        <Style Selector="Button.Segment.Middle">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="Button.Segment.Right">
            <Setter Property="CornerRadius" Value="0,10,10,0"/>
        </Style>
    </Application.Styles>
</Application>
