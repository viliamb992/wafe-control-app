<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base Color Palette - Professional Muted Colors -->
  <Color x:Key="Primary">#3B82F6</Color>
  <Color x:Key="PrimaryDark">#2563EB</Color>
  <Color x:Key="PrimaryLight">#60A5FA</Color>

  <Color x:Key="BackgroundDark">#0F172A</Color>
  <Color x:Key="BackgroundMedium">#1E293B</Color>
  <Color x:Key="BackgroundLight">#334155</Color>

  <Color x:Key="TextPrimary">#E2E8F0</Color>
  <Color x:Key="TextSecondary">#94A3B8</Color>
  <Color x:Key="TextMuted">#64748B</Color>

  <!-- Professional Muted Colors - Replacing bright colors -->
  <Color x:Key="Success">#059669</Color>
  <Color x:Key="SuccessDark">#047857</Color>
  <Color x:Key="SuccessLight">#10B981</Color>

  <Color x:Key="Danger">#DC2626</Color>
  <Color x:Key="DangerDark">#B91C1C</Color>
  <Color x:Key="DangerLight">#EF4444</Color>

  <Color x:Key="Warning">#D97706</Color>
  <Color x:Key="WarningDark">#B45309</Color>
  <Color x:Key="WarningLight">#F59E0B</Color>

  <Color x:Key="Info">#8B5CF6</Color>
  <Color x:Key="InfoDark">#7C3AED</Color>
  <Color x:Key="InfoLight">#A78BFA</Color>

  <!-- Neutral accent for professional look -->
  <Color x:Key="Accent">#475569</Color>
  <Color x:Key="AccentLight">#64748B</Color>
  <Color x:Key="AccentDark">#334155</Color>

  <Color x:Key="Border">#475569</Color>
  <Color x:Key="BorderLight">#CBD5E1</Color>

  <!-- Solid Color Brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>

  <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
  <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
  <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
  <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource SuccessDark}"/>
  <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLight}"/>

  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
  <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDark}"/>
  <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>

  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
  <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource WarningDark}"/>
  <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLight}"/>

  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
  <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource InfoDark}"/>
  <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLight}"/>

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
  <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>

  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
  <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>

  <!-- Professional Subtle Gradients -->
  <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Primary}" Offset="0"/>
    <GradientStop Color="{StaticResource PrimaryDark}" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Success}" Offset="0"/>
    <GradientStop Color="{StaticResource SuccessDark}" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DangerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Danger}" Offset="0"/>
    <GradientStop Color="{StaticResource DangerDark}" Offset="1"/>
  </LinearGradientBrush>

  <!-- Muted Warning Gradient for Boost Buttons -->
  <LinearGradientBrush x:Key="WarningGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Warning}" Offset="0"/>
    <GradientStop Color="{StaticResource WarningDark}" Offset="1"/>
  </LinearGradientBrush>

  <!-- Professional Neutral Gradient for Boost Buttons -->
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource AccentLight}" Offset="0"/>
    <GradientStop Color="{StaticResource Accent}" Offset="1"/>
  </LinearGradientBrush>

  <!-- System State Gradients - More Professional -->
  <LinearGradientBrush x:Key="SystemRunningGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Danger}" Offset="0"/>
    <GradientStop Color="{StaticResource DangerDark}" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SystemStoppedGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource Success}" Offset="0"/>
    <GradientStop Color="{StaticResource SuccessDark}" Offset="1"/>
  </LinearGradientBrush>

  <Color x:Key="OverlayLight">#40FFFFFF</Color>
  <SolidColorBrush x:Key="OverlayLightBrush" Color="{StaticResource OverlayLight}"/>

</ResourceDictionary>
