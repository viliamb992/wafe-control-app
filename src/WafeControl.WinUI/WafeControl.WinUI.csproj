<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows 11 only. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>WafeControl.WinUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>

    <!-- Unpackaged, self-contained Windows App SDK: runs as a plain exe (`dotnet run`), no runtime installer.
         Distributed with an Inno Setup installer (installer/WafeControl.iss) instead of MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Follow the selected platform (VS / solution); plain `dotnet build` (AnyCPU) uses the machine's architecture. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>

    <!-- Program.cs provides Main to enforce a single instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Only the app's languages (Czech, Slovak, English); see _RemoveUnusedWinUILanguages below. -->
    <SatelliteResourceLanguages>cs;sk;en</SatelliteResourceLanguages>

    <AssemblyTitle>WAFE Control</AssemblyTitle>
    <Product>WAFE Control</Product>
    <Description>Smart Ventilation Control System</Description>
    <Copyright>Copyright © 2026 Viliam Birmon</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WafeControl.Core\WafeControl.Core.csproj" />
  </ItemGroup>

  <!-- The self-contained Windows App SDK copies its control strings as <culture>\*.mui for ~90 languages, which
       SatelliteResourceLanguages doesn't filter. Keep the app's languages (en-us is also WinUI's fallback). -->
  <Target Name="_RemoveUnusedWinUILanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_UnusedWinUIMui Include="@(None)"
                       Condition="'%(None.Extension)' == '.mui' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(None.Link)', '(?i)^(cs-CZ|sk-SK|en-US)\\'))" />
      <None Remove="@(_UnusedWinUIMui)" />
    </ItemGroup>
  </Target>

</Project>
