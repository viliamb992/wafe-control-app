<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="installer/WafeRecuperation.iss" />
    <File Path="nuget.config" />
    <File Path="README.md" />
    <File Path="TODO.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/RecuperationSystem.Core/RecuperationSystem.Core.csproj" />
    <Project Path="src/RecuperationSystem.Shared/RecuperationSystem.Shared.csproj" />
    <!-- WinUI builds per architecture only: "Any CPU" maps to x64. -->
    <Project Path="src/RecuperationSystem.WinUI/RecuperationSystem.WinUI.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="src/RecuperationSystem.Tests/RecuperationSystem.Tests.csproj" />
  </Folder>
</Solution>
