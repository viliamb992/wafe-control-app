<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org, so machine-level feeds can't leak in (central package management warns otherwise). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
